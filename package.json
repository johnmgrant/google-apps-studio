{
  "name": "@johnmgrant/google-apps-scripts",
  "version": "1.0.0",
  "description": "Collection of Google Apps Scripts",
  "scripts": {
    "postinstall": "pnpm run build-tool:tsconfig && pnpm run build-package:sheets-utility && pnpm run build-library:fitness-models",
    "build-tool:tsconfig": "pnpm --filter ./tools/tsconfig run build",
    "build-package:sheets-utility": "pnpm --filter ./packages/sheets-utility run build",
    "build-library:fitness-models": "pnpm --filter ./packages/fitness-models run build",
    "clasp": "clasp",
    "build": "turbo build",
    "build:projects": "pnpm -r --filter './projects/*' run build",
    "push": "pnpm -r --filter './projects/*' run push",
    "pull": "pnpm -r --filter './projects/*' run pull",
    "deploy": "pnpm -r --filter './projects/*' run deploy",
    "push:lor": "pnpm --filter ./projects/templatization-lor run push",
    "lint": "turbo run lint",
    "lint:fix": "eslint 'projects/*/src/**/*.ts' --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write '**/*.{ts,js,json,md,yaml,yml}' --ignore-path .gitignore",
    "format:check": "turbo run format:check",
    "prepare": "husky install"
  },
  "keywords": [
    "google-apps-script",
    "clasp",
    "typescript"
  ],
  "author": "John Mitchell-Grant",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/clasp": "^3.4.0",
    "@johnmgrant/fitness-models": "workspace:^",
    "@johnmgrant/sheets-utility": "workspace:^",
    "@johnmgrant/tools__tsconfig": "workspace:^",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript/typescript6": "^6.0.2",
    "@types/eslint": "^9.6.1",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/google-apps-script": "^2.0.12",
    "@types/node": "^26.4.0",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.5",
    "editorconfig": "^3.0.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^13.0.6",
    "globals": "^17.11.0",
    "husky": "^9.0.11",
    "jiti": "^2.7.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5"
  },
  "packageManager": "pnpm@11.24.0"
}
