{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "./src/configs/node",
  "compilerOptions": {
    "strict": true,
    "composite": true,

    "outDir": "dist",

    "rootDir": "./src",
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": ["node_modules", "dist"]
}
